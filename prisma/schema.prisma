generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Slot {
  id           Int      @id @default(autoincrement())
  date         DateTime
  startTime    String
  endTime      String
  type         String
  limit        Int
  visibleSince DateTime @default(now())

  registrations Registration[]
}

model Registration {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String

  slotId Int
  slot   Slot @relation(fields: [slotId], references: [id])
}
